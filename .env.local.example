# OpenHost server-side configuration
# Copy to .env.local (Next.js) and to your deploy host.

# --- Supabase (data layer) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- AWS platform credentials (mode 1: platform-managed) ---
# IAM user/role with: S3, Lambda, CloudFront, Route53, ACM, IAM (role create)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- GitHub integration (M4) ---
# Optional: token used for cloning private repos if none is stored inline.
GITHUB_TOKEN=
# Required for push webhooks (set the same secret in your repo's webhook).
GITHUB_WEBHOOK_SECRET=

# --- Build executor (M5c) ---
# "codebuild" → builds run in an ephemeral container in your AWS account
# "local"     → builds run on this machine as child processes (dev fallback)
# When unset: codebuild if AWS creds exist, otherwise local.
OPENHOST_BUILD_MODE=

# --- Supabase Auth (SERVER-ONLY — never exposed to the browser) ---
# Reuses $SUPABASE_URL above; Next.js expands variables in .env files.
# Do NOT rename these to NEXT_PUBLIC_* — the anon key must not ship to the
# client because RLS policies in db/schema.sql are still open (using (true)).
SUPABASE_ANON_KEY=your_anon_publishable_key
